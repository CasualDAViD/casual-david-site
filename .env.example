# Copy this file to .env and fill it in. Never commit .env.

# --- Required -----------------------------------------------------------
# The public address of the site, exactly as visitors type it (no trailing slash).
# Use https:// in production: it turns on Secure cookies and HSTS.
SITE_URL=https://casualdavid.com

# --- Server -------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Where the database and uploaded files live. Back this folder up.
DATA_DIR=/var/lib/casual-david
# Number of reverse proxies in front of the app (nginx = loopback).
TRUST_PROXY=loopback
# Largest mod file the admin can upload, in megabytes.
MAX_MOD_FILE_MB=200

# --- Payments (Paystack) --------------------------------------------------
# Paystack dashboard > Settings > API Keys & Webhooks.
# Use sk_test_... while testing and sk_live_... for real money.
PAYSTACK_SECRET_KEY=
# Webhook URL to set in the Paystack dashboard: https://YOUR-SITE/api/paystack/webhook

# Prices are stored in USD and charged in naira at this rate (NGN per 1 USD).
RATE_NGN=1550
RATE_EUR=0.92

# --- Email (receipts and password reset). Leave blank to switch email off ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Casual_DAViD <no-reply@casualdavid.com>"

# --- Sign in with Google / Discord. Leave blank to hide the buttons ------
# Redirect URI to register with each provider:
#   https://YOUR-SITE/api/auth/oauth/google/callback
#   https://YOUR-SITE/api/auth/oauth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
